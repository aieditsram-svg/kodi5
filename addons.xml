<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.telugulive" name="Telugu Live" version="2.1.0" provider-name="Telugu Live">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Live Indian TV in every language, HD first, with automatic failover</summary>
    <description lang="en_GB">Free Indian TV channels split by language (Telugu, Hindi, Tamil, Kannada, Malayalam, Bengali and more), with an HD-only view and a one-click setup for Live TV (PVR IPTV Simple Client). The playlist is rebuilt every 5 minutes and the add-on tests each stream on your own network, switching to a working link when one fails.</description>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
  </extension>
</addon>
<addon id="repository.telugulive" name="Telugu Live Repository" version="1.0.1" provider-name="Telugu Live">
  <extension point="xbmc.addon.repository" name="Telugu Live Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/aieditsram-svg/kodi/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/aieditsram-svg/kodi/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/aieditsram-svg/kodi/main/zips/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Telugu Live add-on repository</summary>
    <description lang="en_GB">Hosts the Telugu Live video add-on, which plays an auto-updating playlist of working free-to-air Telugu TV channels.</description>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
  </extension>
</addon>
</addons>
